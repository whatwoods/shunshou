{
  "name": "shunshou",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "promo": "vite --config promo/vite.config.ts",
    "promo:video": "node promo/scripts/render.mjs --out=promo/out/video.mp4",
    "promo:music": "node promo/scripts/audio.mjs",
    "promo:build": "npm run promo:video && npm run promo:music && ffmpeg -loglevel error -y -i promo/out/video.mp4 -i promo/out/music.wav -map 0:v -map 1:a -c:v copy -af loudnorm=I=-16:TP=-1.5:LRA=11 -ar 48000 -c:a aac -b:a 256k -movflags +faststart -shortest promo/out/shunshou-promo.mp4",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.js\" vite.config.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@e965/xlsx": "^0.20.3",
    "@js-temporal/polyfill": "^0.5.1",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@mediabunny/mp3-encoder": "^1.61.3",
    "@scure/bip39": "^2.4.0",
    "change-case": "^5.4.4",
    "culori": "^4.0.2",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "entities": "^8.1.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "gpt-tokenizer": "^4.0.0",
    "hash-wasm": "^4.12.0",
    "highlight.js": "^11.12.0",
    "hyparquet": "^1.31.3",
    "hyparquet-compressors": "^1.1.2",
    "jsonc-parser": "^3.3.1",
    "jsonrepair": "^3.15.0",
    "jsqr": "^1.4.0",
    "libheif-js": "^1.23.5",
    "marked": "^18.1.0",
    "mediabunny": "^1.61.3",
    "onnxruntime-web": "^1.30.0",
    "opencc-js": "^1.4.2",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "saxes": "^6.0.0",
    "sql-formatter": "^15.9.0",
    "sql.js": "^1.14.2",
    "svgo": "^4.1.0",
    "ulid": "^3.0.2",
    "uuid": "^14.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@types/culori": "^4.0.1",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
