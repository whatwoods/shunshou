// 整站都是静态资源：Worker 只负责把 dist/ 交给浏览器，没有任何后端逻辑
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shunshou",
  "compatibility_date": "2026-10-01",
  // wrangler deploy / dev 之前先构建，Cloudflare 连 Git 自动部署时只跑 wrangler deploy 也能拿到 dist/
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    // 构建时为每个公开路由输出 HTML；未知地址返回真正的 404
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
